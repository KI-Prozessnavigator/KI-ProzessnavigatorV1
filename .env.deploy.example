# IONOS Cloud Server – Deploy-Konfiguration
# Diese Datei als .env.deploy kopieren und Werte eintragen.
# .env.deploy wird nicht ins Git übernommen (sicher).
# Vollständige Anleitung: docs/IONOS-CLAUDE-SERVER-DEPLOY.md

# Server (IP oder Hostname vom IONOS Cloud Server / DCD-VM)
IONOS_HOST=ihre-server-ip-oder-hostname.de

# SSH-Benutzer (z.B. root oder ein Benutzer mit Schreibrechten)
IONOS_USER=root

# Webroot auf dem Server (Verzeichnis, in das die Website kommt)
# Typisch unter Linux: /var/www/html
IONOS_WEBROOT=/var/www/html

# SSH-Port (meist 22)
IONOS_PORT=22

# Optional: Pfad zu Ihrem privaten SSH-Key (für passwortlosen Zugang)
# Leer lassen = Passwortabfrage beim Upload
# Beispiel Windows: C:\Users\IhrName\.ssh\id_rsa
# IONOS_SSH_KEY=
