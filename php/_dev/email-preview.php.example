<?php
// ==================== DEV TOOL: E-Mail Template Vorschau ====================
// Zweck: Lokale Vorschau der E-Mail-Optik im Browser (ohne echten Versand).
//
// Nutzung (Windows):
//   1) Datei einmalig lokal aktivieren (ohne Commit):
//        copy php\\_dev\\email-preview.php.example php\\_dev\\email-preview.php
//   2) Im Projekt-Root starten:
//        php -S localhost:8000
//   3) Öffnen:
//        http://localhost:8000/php/_dev/email-preview.php
//
// Sicherheit: Nur lokal (127.0.0.1 / ::1) nutzbar.

header('Content-Type: text/html; charset=utf-8');

$remoteAddr = $_SERVER['REMOTE_ADDR'] ?? '';
$isLocal = ($remoteAddr === '127.0.0.1' || $remoteAddr === '::1');
if (!$isLocal) {
    http_response_code(404);
    echo 'Not Found';
    exit;
}

require_once __DIR__ . '/../templates/contact-owner.php';
require_once __DIR__ . '/../templates/contact-confirmation.php';
require_once __DIR__ . '/../templates/checklist-customer.php';
require_once __DIR__ . '/../templates/checklist-owner.php';

$calendlyUrl = 'https://calendly.com/d-buchele-ki-prozessnavigator/30min';

// Beispiel-Daten (so ähnlich kommen sie aus dem Frontend)
$sampleContact = [
    'firstName' => 'Max',
    'lastName' => 'Mustermann',
    'email' => 'max@unternehmen.de',
    'phone' => '+49 123 456789',
    'company' => 'Muster GmbH',
    'message' => "Hallo Dominik,\nwir interessieren uns für Automatisierung im Backoffice.\nBitte melde dich diese Woche.",
    'companySize' => '11-50',
    'interest' => 'Potenzialanalyse',
];

$sampleLeadEmail = 'lead@beispiel.de';

function h($s) {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}

$view = $_GET['view'] ?? 'contact-owner';
$mode = $_GET['mode'] ?? 'render'; // render | source | plain

$items = [
    'contact-owner' => 'Kontakt → Betreiber (du)',
    'contact-confirmation' => 'Kontakt → Bestätigung (Absender)',
    'checklist-customer' => 'Checkliste → Anfragender',
    'checklist-owner' => 'Checkliste → Lead-Hinweis (du)',
];

function getTemplatePayload($view, $sampleContact, $sampleLeadEmail, $calendlyUrl) {
    switch ($view) {
        case 'contact-confirmation':
            return [
                'subject' => kp_contact_confirmation_subject(),
                'html' => kp_contact_confirmation_html($sampleContact),
                'plain' => kp_contact_confirmation_plain($sampleContact),
            ];
        case 'checklist-customer':
            return [
                'subject' => kp_checklist_customer_subject(),
                'html' => kp_checklist_customer_html($calendlyUrl),
                'plain' => kp_checklist_customer_plain($calendlyUrl),
            ];
        case 'checklist-owner':
            return [
                'subject' => kp_checklist_owner_subject($sampleLeadEmail),
                'html' => kp_checklist_owner_html($sampleLeadEmail, $calendlyUrl),
                'plain' => kp_checklist_owner_plain($sampleLeadEmail, $calendlyUrl),
            ];
        case 'contact-owner':
        default:
            return [
                'subject' => kp_contact_owner_subject($sampleContact),
                'html' => kp_contact_owner_html($sampleContact),
                'plain' => kp_contact_owner_plain($sampleContact),
            ];
    }
}

$payload = getTemplatePayload($view, $sampleContact, $sampleLeadEmail, $calendlyUrl);

?>
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-Mail Vorschau (lokal) – KI-Prozessnavigator</title>
    <style>
        :root { color-scheme: light; }
        body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; background: #0b1220; color: #e5e7eb; }
        .wrap { max-width: 1200px; margin: 0 auto; padding: 20px; }
        .top { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .title { font-weight: 700; }
        .badge { font-size: 12px; opacity: 0.8; }
        .nav { display: flex; gap: 8px; flex-wrap: wrap; }
        .nav a { color: #e5e7eb; text-decoration: none; padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
        .nav a.active { border-color: rgba(0,119,255,0.6); background: rgba(0,119,255,0.18); }
        .modes { display: flex; gap: 8px; flex-wrap: wrap; }
        .modes a { color: #e5e7eb; text-decoration: none; padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
        .modes a.active { border-color: rgba(0,217,143,0.6); background: rgba(0,217,143,0.18); }
        .card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.10); border-radius: 14px; overflow: hidden; }
        .meta { padding: 14px 16px; border-bottom: 1px solid rgba(255,255,255,0.10); display: grid; gap: 6px; }
        .metaLabel { font-size: 12px; opacity: 0.8; }
        .metaValue { font-size: 14px; }
        .content { background: #0f172a; }
        iframe { width: 100%; height: 78vh; border: 0; background: #fff; }
        pre { margin: 0; padding: 16px; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; color: #e5e7eb; }
        .hint { font-size: 12px; opacity: 0.75; margin-top: 10px; }
        code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="top">
            <div>
                <div class="title">E-Mail Template Vorschau (lokal)</div>
                <div class="badge">Nur erreichbar über <code>localhost</code> / <code>127.0.0.1</code></div>
            </div>
            <div class="modes">
                <a class="<?= $mode === 'render' ? 'active' : '' ?>" href="?view=<?= h($view) ?>&mode=render">Render</a>
                <a class="<?= $mode === 'source' ? 'active' : '' ?>" href="?view=<?= h($view) ?>&mode=source">HTML-Quelle</a>
                <a class="<?= $mode === 'plain' ? 'active' : '' ?>" href="?view=<?= h($view) ?>&mode=plain">Plain-Text</a>
            </div>
        </div>

        <div class="nav" style="margin-bottom: 14px;">
            <?php foreach ($items as $key => $label): ?>
                <a class="<?= $view === $key ? 'active' : '' ?>" href="?view=<?= h($key) ?>&mode=<?= h($mode) ?>"><?= h($label) ?></a>
            <?php endforeach; ?>
        </div>

        <div class="card">
            <div class="meta">
                <div class="metaLabel">Betreff</div>
                <div class="metaValue"><?= h($payload['subject']) ?></div>
            </div>
            <div class="content">
                <?php if ($mode === 'plain'): ?>
                    <pre><?= h($payload['plain']) ?></pre>
                <?php elseif ($mode === 'source'): ?>
                    <pre><?= h($payload['html']) ?></pre>
                <?php else: ?>
                    <iframe sandbox srcdoc="<?= h($payload['html']) ?>"></iframe>
                <?php endif; ?>
            </div>
        </div>

        <div class="hint">
            Tipp: Mail-Optik bearbeitest du in <code>php/templates/</code>.\n
        </div>
    </div>
</body>
</html>

